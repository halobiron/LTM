# Copy to deploy/.env and fill in. Never commit the real file.

# Public hostnames (all three must point at the VM's public IP; see docs/DEPLOY.md)
API_HOST=api-yourname.duckdns.org
RTC_HOST=rtc-yourname.duckdns.org
S3_HOST=s3-yourname.duckdns.org

# Frontend (Cloudflare Pages / Vercel URL, used for CORS and email links)
FRONTEND_URL=https://syltalky.pages.dev

# Database / storage: choose long random passwords
POSTGRES_USER=syltalky
POSTGRES_PASSWORD=change-me
POSTGRES_DB=syltalky
MINIO_ROOT_USER=syltalky
MINIO_ROOT_PASSWORD=change-me-too
MINIO_BUCKET=syltalky

# JWT: generate with `openssl rand -hex 32`
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LiveKit: generate with `openssl rand -hex 16` / `openssl rand -hex 32`
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me-with-at-least-32-chars

# AI API on the GPU machine, reached over Tailscale (its 100.x.y.z address)
AI_API_URL=http://100.x.y.z:8000

# Gmail SMTP (app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_gmail@gmail.com
SMTP_FROM_NAME=Syltalky

# LLM (any OpenAI-compatible endpoint)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your_key
LLM_MODEL=gemini-3.5-flash-lite

GOOGLE_CLIENT_ID=
